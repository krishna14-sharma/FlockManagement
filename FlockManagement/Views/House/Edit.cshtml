@model HouseViewModel
<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <h1 class="h4 mb-3"><i class="bi bi-house-door text-brand me-2"></i>@ViewBag.Title</h1>
        @using (Html.BeginForm("Save", "House", FormMethod.Post, new { @class = "card shadow-sm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.HouseID)
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.FarmID, new { @class = "form-label required" })
                        @Html.DropDownListFor(m => m.FarmID, Model.Farms, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.FarmID, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-2">
                        @Html.LabelFor(m => m.HouseCode, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.HouseCode, new { @class = "form-control text-uppercase", maxlength = 20 })
                        @Html.ValidationMessageFor(m => m.HouseCode, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.HouseName, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.HouseName, new { @class = "form-control", maxlength = 100 })
                        @Html.ValidationMessageFor(m => m.HouseName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.HouseType, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.HouseType, new { @class = "form-control", maxlength = 50, list = "houseTypes" })
                        <datalist id="houseTypes">
                            @foreach (var t in Model.HouseTypes) { <option value="@t"></option> }
                        </datalist>
                    </div>
                    <div class="col-6 col-md-4">
                        @Html.LabelFor(m => m.Capacity, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Capacity, new { @class = "form-control text-end", type = "number", min = 0, step = 1, inputmode = "numeric" })
                        @Html.ValidationMessageFor(m => m.Capacity, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-6 col-md-4">
                        @Html.LabelFor(m => m.AreaSqFt, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.AreaSqFt, new { @class = "form-control text-end", type = "number", min = 0, step = "0.01", inputmode = "decimal" })
                        @Html.ValidationMessageFor(m => m.AreaSqFt, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                        </div>
                    </div>
                </div>
                @Html.Partial("_FormButtons")
            </div>
        }
    </div>
</div>
