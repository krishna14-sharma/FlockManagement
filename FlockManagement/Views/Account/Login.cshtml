@model LoginViewModel
@{
    ViewBag.Title = "Sign in";
}
<div class="login-wrap d-flex align-items-center justify-content-center">
    <div class="card shadow login-card w-100">
        <div class="card-body p-4 p-sm-5">
            <div class="text-center mb-4">
                <div class="login-logo mx-auto mb-3"><i class="bi bi-egg-fried"></i></div>
                <h1 class="h4 mb-1">Flock Weight Management</h1>
                <p class="text-muted small mb-0">Breeder flock analysis &amp; decision support</p>
            </div>
            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { novalidate = "novalidate", autocomplete = "on" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReturnUrl)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })
                <div class="mb-3">
                    @Html.LabelFor(m => m.UserName, new { @class = "form-label" })
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", autocomplete = "username", autofocus = "autofocus", maxlength = 50, autocapitalize = "none" })
                    </div>
                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger small" })
                </div>
                <div class="mb-4">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password", maxlength = 128 })
                        <button class="btn btn-outline-secondary" type="button" data-toggle-password="#Password" aria-label="Show password"><i class="bi bi-eye"></i></button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2"><i class="bi bi-box-arrow-in-right me-1"></i>Sign in</button>
            }
        </div>
        <div class="card-footer text-center small text-muted bg-white">Accounts are locked after repeated failed attempts. Contact your administrator for access.</div>
    </div>
</div>
