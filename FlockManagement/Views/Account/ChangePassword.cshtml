@model ChangePasswordViewModel
@{
    ViewBag.Title = "Change Password";
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
        <h1 class="h4 mb-3"><i class="bi bi-key text-brand me-2"></i>Change Password</h1>
        @if (Model.IsForced)
        {
            <div class="alert alert-warning d-flex gap-2"><i class="bi bi-shield-exclamation"></i><div>For security you must set a new password before continuing.</div></div>
        }
        @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { @class = "card shadow-sm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                <div class="mb-3">
                    @Html.LabelFor(m => m.CurrentPassword, new { @class = "form-label required" })
                    @Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control", autocomplete = "current-password" })
                    @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "text-danger small" })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.NewPassword, new { @class = "form-label required" })
                    @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger small" })
                    <div class="form-text">At least 8 characters with upper-case, lower-case letters and a digit.</div>
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label required" })
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password" })
                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                </div>
                <div class="d-flex gap-2 justify-content-end">
                    @if (!Model.IsForced)
                    {
                        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Home")">Cancel</a>
                    }
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>Change Password</button>
                </div>
            </div>
        }
    </div>
</div>
