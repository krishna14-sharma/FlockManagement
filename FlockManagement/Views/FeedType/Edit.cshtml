@model FeedTypeViewModel
<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-7">
        <h1 class="h4 mb-3"><i class="bi bi-basket text-brand me-2"></i>@ViewBag.Title</h1>
        @using (Html.BeginForm("Save", "FeedType", FormMethod.Post, new { @class = "card shadow-sm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.FeedTypeID)
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                <div class="row g-3">
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.FeedTypeCode, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.FeedTypeCode, new { @class = "form-control text-uppercase", maxlength = 20, autofocus = "autofocus" })
                        @Html.ValidationMessageFor(m => m.FeedTypeCode, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-8">
                        @Html.LabelFor(m => m.FeedTypeName, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.FeedTypeName, new { @class = "form-control", maxlength = 100 })
                        @Html.ValidationMessageFor(m => m.FeedTypeName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.TargetSex, new { @class = "form-label required" })
                        @Html.DropDownListFor(m => m.TargetSex, FeedTypeViewModel.SexOptions(Model.TargetSex), new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.TargetSex, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-6 col-md-4">
                        @Html.LabelFor(m => m.ApplicableFromWeek, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ApplicableFromWeek, new { @class = "form-control text-end", type = "number", min = 0, max = 120, step = 1 })
                        @Html.ValidationMessageFor(m => m.ApplicableFromWeek, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-6 col-md-4">
                        @Html.LabelFor(m => m.ApplicableToWeek, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ApplicableToWeek, new { @class = "form-control text-end", type = "number", min = 0, max = 120, step = 1 })
                        @Html.ValidationMessageFor(m => m.ApplicableToWeek, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-12">
                        <div class="form-text"><i class="bi bi-info-circle me-1"></i>The age range is used to suggest the feed type on the weekly entry screen. Leave blank if the feed can be used at any age.</div>
                    </div>
                    <div class="col-12">
                        @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Description, 3, 0, new { @class = "form-control", maxlength = 250 })
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                        </div>
                    </div>
                </div>
                @Html.Partial("_FormButtons")
            </div>
        }
    </div>
</div>
