@model StandardGridViewModel
@{
    ViewBag.Title = "Standards Grid";
    var p = Model.SelectedParameter;
    var dec = p != null ? p.DecimalPlaces : 2;
    var step = dec == 0 ? "1" : "0." + new string('0', dec - 1) + "1";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0"><i class="bi bi-grid-3x3 text-brand me-2"></i>Standards by Week</h1>
    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index")"><i class="bi bi-list me-1"></i>All standards</a>
</div>

<form method="get" class="card card-body shadow-sm mb-3 filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">Bird Type *</label>
            @Html.DropDownList("birdTypeId", Model.BirdTypes, new { @class = "form-select" })
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">Breed</label>
            @Html.DropDownList("breedId", Model.Breeds, new { @class = "form-select" })
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">Feed Type</label>
            @Html.DropDownList("feedTypeId", Model.FeedTypes, new { @class = "form-select" })
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small text-muted mb-1">Parameter *</label>
            @Html.DropDownList("parameterId", Model.Parameters, new { @class = "form-select" })
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1">Effective From</label>
            <input type="date" class="form-control" name="effectiveFrom" value="@(Model.EffectiveFrom.HasValue ? Model.EffectiveFrom.Value.ToString("yyyy-MM-dd") : "")" list="effDates" />
            <datalist id="effDates">@foreach (var d in Model.ExistingDates) { <option value="@d.ToString("yyyy-MM-dd")"></option> }</datalist>
        </div>
        <div class="col-6 col-md-1 d-grid">
            <button type="submit" class="btn btn-primary">Load</button>
        </div>
    </div>
    @if (Model.ExistingDates.Count > 0)
    {
        <div class="small text-muted mt-2">Existing effective dates for this bird type / parameter: @string.Join(", ", Model.ExistingDates.Select(d => d.ToString("dd-MMM-yyyy")))</div>
    }
</form>

@if (Model.Loaded)
{
    using (Html.BeginForm("Grid", "Standard", FormMethod.Post, new { id = "gridForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.BirdTypeID)
        @Html.HiddenFor(m => m.BreedID)
        @Html.HiddenFor(m => m.FeedTypeID)
        @Html.HiddenFor(m => m.ParameterID)
        @Html.HiddenFor(m => m.LastWeek)
        <input type="hidden" name="EffectiveFrom" value="@Model.EffectiveFrom.Value.ToString("yyyy-MM-dd")" />
        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex flex-wrap gap-3 justify-content-between align-items-center">
                <div>
                    <span class="fw-semibold">@(p != null ? p.ParameterName : "Parameter")</span>
                    <span class="text-muted small ms-2">unit: @(p != null ? p.UnitCode : "-") &middot; effective from @Model.EffectiveFrom.Value.ToString("dd-MMM-yyyy")</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted" for="EffectiveTo">Effective To</label>
                    <input type="date" class="form-control form-control-sm" style="width:auto" id="EffectiveTo" name="EffectiveTo" value="@(Model.EffectiveTo.HasValue ? Model.EffectiveTo.Value.ToString("yyyy-MM-dd") : "")" />
                    @if (Model.CanEdit)
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown">Fill limits</button>
                            <div class="dropdown-menu dropdown-menu-end p-3" style="min-width:260px">
                                <label class="form-label small">Min / Max = standard &plusmn; %</label>
                                <div class="input-group input-group-sm mb-2"><input type="number" class="form-control" id="fillPct" value="5" step="0.5" min="0" /><span class="input-group-text">%</span></div>
                                <label class="form-label small">Critical = standard &plusmn; % (blank = none)</label>
                                <div class="input-group input-group-sm mb-2"><input type="number" class="form-control" id="fillCritPct" value="" step="0.5" min="0" /><span class="input-group-text">%</span></div>
                                <button type="button" class="btn btn-sm btn-primary w-100" id="btnFill">Apply to rows with a standard</button>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="table-responsive" style="max-height:65vh">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light sticky-top">
                        <tr><th style="width:80px">Week</th><th>Standard</th><th>Min</th><th>Max</th><th>Critical Min</th><th>Critical Max</th></tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Rows.Count; i++)
                        {
                            var r = Model.Rows[i];
                            <tr class="grid-row">
                                <td class="fw-semibold">@r.AgeWeek<input type="hidden" name="Rows[@i].AgeWeek" value="@r.AgeWeek" /></td>
                                <td><input type="number" class="form-control form-control-sm text-end js-std" name="Rows[@i].StandardValue" value="@(r.StandardValue.HasValue ? r.StandardValue.Value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) : "")" step="@step" @(Model.CanEdit ? "" : "readonly") /></td>
                                <td><input type="number" class="form-control form-control-sm text-end js-min" name="Rows[@i].MinValue" value="@(r.MinValue.HasValue ? r.MinValue.Value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) : "")" step="@step" @(Model.CanEdit ? "" : "readonly") /></td>
                                <td><input type="number" class="form-control form-control-sm text-end js-max" name="Rows[@i].MaxValue" value="@(r.MaxValue.HasValue ? r.MaxValue.Value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) : "")" step="@step" @(Model.CanEdit ? "" : "readonly") /></td>
                                <td><input type="number" class="form-control form-control-sm text-end js-cmin" name="Rows[@i].CriticalMinValue" value="@(r.CriticalMinValue.HasValue ? r.CriticalMinValue.Value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) : "")" step="@step" @(Model.CanEdit ? "" : "readonly") /></td>
                                <td><input type="number" class="form-control form-control-sm text-end js-cmax" name="Rows[@i].CriticalMaxValue" value="@(r.CriticalMaxValue.HasValue ? r.CriticalMaxValue.Value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) : "")" step="@step" @(Model.CanEdit ? "" : "readonly") /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.CanEdit)
            {
                <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="small text-muted">Clear a week's standard to remove that week. Tip: paste a column of values from Excel into the first box and it fills down.</span>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Standards</button>
                </div>
            }
        </div>
    }
}
else
{
    <div class="text-muted text-center py-5">Select a bird type and parameter, then <strong>Load</strong>.</div>
}

@section scripts {
<script>
    (function () {
        var dec = @dec;
        function round(v) { var f = Math.pow(10, dec); return Math.round(v * f) / f; }
        $('#btnFill').on('click', function () {
            var pct = fwm.parseNum($('#fillPct').val()), cpct = fwm.parseNum($('#fillCritPct').val());
            $('.grid-row').each(function () {
                var std = fwm.parseNum($(this).find('.js-std').val());
                if (std === null) return;
                if (pct !== null) { $(this).find('.js-min').val(round(std * (1 - pct / 100))); $(this).find('.js-max').val(round(std * (1 + pct / 100))); }
                if (cpct !== null) { $(this).find('.js-cmin').val(round(std * (1 - cpct / 100))); $(this).find('.js-cmax').val(round(std * (1 + cpct / 100))); }
            });
        });
        // paste a column of numbers from Excel: fills down the same column
        $(document).on('paste', '.grid-row input', function (e) {
            var text = (e.originalEvent.clipboardData || window.clipboardData).getData('text');
            var lines = text.split(/\r?\n/).filter(function (l) { return l.trim() !== ''; });
            if (lines.length < 2) return;
            e.preventDefault();
            var cls = this.className.split(' ').filter(function (c) { return c.indexOf('js-') === 0; })[0];
            var $rows = $('.grid-row'), start = $rows.index($(this).closest('tr'));
            lines.forEach(function (l, i) {
                var $row = $rows.eq(start + i);
                if ($row.length) $row.find('.' + cls).val(fwm.parseNum(l.split('\t')[0]));
            });
        });
    })();
</script>
}
