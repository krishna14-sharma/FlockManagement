@model FarmViewModel
<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <h1 class="h4 mb-3"><i class="bi bi-geo-alt text-brand me-2"></i>@ViewBag.Title</h1>
        @using (Html.BeginForm("Save", "Farm", FormMethod.Post, new { @class = "card shadow-sm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.FarmID)
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                <div class="row g-3">
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.FarmCode, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.FarmCode, new { @class = "form-control text-uppercase", maxlength = 20, autofocus = "autofocus" })
                        @Html.ValidationMessageFor(m => m.FarmCode, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-8">
                        @Html.LabelFor(m => m.FarmName, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.FarmName, new { @class = "form-control", maxlength = 100 })
                        @Html.ValidationMessageFor(m => m.FarmName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Location, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Location, new { @class = "form-control", maxlength = 100 })
                        @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(m => m.ContactPerson, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ContactPerson, new { @class = "form-control", maxlength = 100 })
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(m => m.ContactNumber, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ContactNumber, new { @class = "form-control", maxlength = 30, type = "tel" })
                        @Html.ValidationMessageFor(m => m.ContactNumber, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-12">
                        @Html.LabelFor(m => m.Address, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Address, 2, 0, new { @class = "form-control", maxlength = 300 })
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                        </div>
                    </div>
                </div>
                @Html.Partial("_FormButtons")
            </div>
        }
    </div>
</div>
