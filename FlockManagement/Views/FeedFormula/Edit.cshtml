@model FeedFormulaEditViewModel
@{
    ViewBag.Title = Model.FeedFormulaID == 0 ? "New Feed Formula" : "Edit Feed Formula";
}
<div class="row justify-content-center">
    <div class="col-12 col-xxl-10">
        <h1 class="h4 mb-3"><i class="bi bi-eyedropper text-brand me-2"></i>@ViewBag.Title</h1>
        @using (Html.BeginForm("Save", "FeedFormula", FormMethod.Post, new { novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.FeedFormulaID)
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold"><i class="bi bi-card-heading me-1"></i>Formula</div>
                <div class="card-body row g-3">
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.FeedTypeID, new { @class = "form-label required" })
                        @Html.DropDownListFor(m => m.FeedTypeID, Model.FeedTypes, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.FeedTypeID, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.FormulaCode, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.FormulaCode, new { @class = "form-control text-uppercase", maxlength = 30 })
                        @Html.ValidationMessageFor(m => m.FormulaCode, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.FormulaName, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.FormulaName, new { @class = "form-control", maxlength = 100 })
                        @Html.ValidationMessageFor(m => m.FormulaName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-6 col-md-3">
                        @Html.LabelFor(m => m.EffectiveFrom, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.EffectiveFrom, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.EffectiveFrom, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-6 col-md-3">
                        @Html.LabelFor(m => m.EffectiveTo, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.EffectiveTo, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.EffectiveTo, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Remarks, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control", maxlength = 250 })
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                        </div>
                    </div>
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between"><span class="fw-semibold"><i class="bi bi-list-columns me-1"></i>Declared nutrient values</span><small class="text-muted">Units come from the parameter list</small></div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-stack">
                        <thead class="table-light"><tr><th>Nutrient</th><th>Unit</th><th class="text-end" style="width:180px">Declared Value</th><th class="text-end">Logical Range</th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < Model.Details.Count; i++)
                            {
                                var d = Model.Details[i];
                                <tr>
                                    <td data-label="Nutrient" class="fw-semibold">@d.ParameterName
                                        <input type="hidden" name="Details[@i].ParameterID" value="@d.ParameterID" />
                                        <input type="hidden" name="Details[@i].ParameterCode" value="@d.ParameterCode" />
                                        <input type="hidden" name="Details[@i].ParameterName" value="@d.ParameterName" />
                                        <input type="hidden" name="Details[@i].UnitCode" value="@d.UnitCode" />
                                        <input type="hidden" name="Details[@i].DecimalPlaces" value="@d.DecimalPlaces" />
                                    </td>
                                    <td data-label="Unit" class="text-muted">@d.UnitCode</td>
                                    <td data-label="Declared Value"><input type="number" step="any" min="0" class="form-control form-control-sm text-end" name="Details[@i].Value" value="@(d.Value.HasValue ? d.Value.Value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture) : "")" /></td>
                                    <td data-label="Logical Range" class="text-end text-muted small">@Html.Num(d.LogicalMin, d.DecimalPlaces) &ndash; @Html.Num(d.LogicalMax, d.DecimalPlaces)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-body py-2">@Html.Partial("_FormButtons")</div>
            </div>
        }
    </div>
</div>
