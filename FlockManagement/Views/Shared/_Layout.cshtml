@{
    var app = User as AppPrincipal;
    var isAuth = app != null && Request.IsAuthenticated;
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    var currentAction = (ViewContext.RouteData.Values["action"] as string) ?? string.Empty;
    var pageTitle = ViewBag.Title as string ?? "Flock Weight Management";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@pageTitle - Flock Weight Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/site.css")" />
    @RenderSection("styles", required: false)
</head>
<body class="@(isAuth ? "app-shell" : "app-anon")">

@if (isAuth)
{
    <header class="navbar navbar-dark bg-brand sticky-top shadow-sm px-2 px-lg-3">
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-link text-white d-lg-none p-1" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open menu">
                <i class="bi bi-list fs-3"></i>
            </button>
            <a class="navbar-brand d-flex align-items-center gap-2 fw-semibold" href="@Url.Action("Index", "Home")">
                <i class="bi bi-egg-fried"></i><span class="d-none d-sm-inline">Flock Weight Management</span><span class="d-sm-none">FWM</span>
            </a>
        </div>
        <div class="d-flex align-items-center gap-2">
        @if (app.HasPermission(PermissionCodes.AlertView))
        {
            var alertCount = Html.OpenAlertCount();
            <a class="btn btn-sm btn-outline-light position-relative" href="@Url.Action("Index", "Alert")" title="Open alerts">
                <i class="bi bi-bell"></i>
                @if (alertCount > 0)
                {
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger">@(alertCount > 99 ? "99+" : alertCount.ToString())</span>
                }
            </a>
        }
        <div class="dropdown">
            <button class="btn btn-sm btn-outline-light dropdown-toggle d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-circle"></i>
                <span class="d-none d-md-inline">@app.FullName</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow">
                <li><h6 class="dropdown-header">@app.FullName<br /><small class="text-muted">@app.RoleName</small></h6></li>
                <li><a class="dropdown-item" href="@Url.Action("ChangePassword", "Account")"><i class="bi bi-key me-2"></i>Change password</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { @class = "px-3" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                    }
                </li>
            </ul>
        </div>
        </div>
    </header>

    <div class="d-flex app-body">
        <aside class="offcanvas-lg offcanvas-start sidebar border-end" tabindex="-1" id="sidebar" aria-labelledby="sidebarLabel">
            <div class="offcanvas-header d-lg-none">
                <h5 class="offcanvas-title" id="sidebarLabel">Menu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-0">
                @if (!app.MustChangePassword)
                {
                    @Html.Action("Sidebar", "Navigation", new { currentController = controller, currentAction = currentAction, currentTab = Request.QueryString["tab"] })
                }
            </div>
        </aside>

        <main class="flex-grow-1 app-main">
            <div class="container-fluid py-3 px-2 px-md-4">
                @Html.Partial("_Flash")
                @RenderBody()
            </div>
        </main>
    </div>
}
else
{
    <main class="container py-4">
        @Html.Partial("_Flash")
        @RenderBody()
    </main>
}

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>window.fwmStatuses = @(isAuth ? Html.StatusJson() : MvcHtmlString.Create("{}"));</script>
<script src="@Url.Content("~/Scripts/app.js")"></script>
<script src="@Url.Content("~/Scripts/fwm.js")"></script>
@RenderSection("scripts", required: false)
</body>
</html>
