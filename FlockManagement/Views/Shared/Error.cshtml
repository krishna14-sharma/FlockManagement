@{
    ViewBag.Title = "Error";
}
<div class="text-center py-5">
    <i class="bi bi-exclamation-octagon text-danger display-3"></i>
    <h1 class="h3 mt-3">Something went wrong</h1>
    <p class="text-muted">The error has been logged. Please try again, or contact the administrator if it continues.</p>
    <a class="btn btn-primary" href="@Url.Action("Index", "Home")"><i class="bi bi-house me-1"></i>Back to dashboard</a>
</div>
