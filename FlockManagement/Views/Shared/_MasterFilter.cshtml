@* Filter bar shared by master lists. Expects ViewData: Search, Status, ParentOptions (optional), ParentLabel *@
@{
    var search = ViewData["Search"] as string;
    var status = (ViewData["Status"] as string) ?? "active";
    var parentOptions = ViewData["ParentOptions"] as IEnumerable<SelectListItem>;
    var parentLabel = (ViewData["ParentLabel"] as string) ?? "Farm";
}
<form method="get" class="card card-body shadow-sm mb-3 filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-5">
            <label class="form-label small text-muted mb-1" for="search">Search</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="search" class="form-control" id="search" name="search" value="@search" placeholder="Code or name" maxlength="100" />
            </div>
        </div>
        @if (parentOptions != null)
        {
            <div class="col-6 col-md-3">
                <label class="form-label small text-muted mb-1" for="parentId">@parentLabel</label>
                @Html.DropDownList("parentId", parentOptions, new { @class = "form-select", id = "parentId" })
            </div>
        }
        <div class="col-6 col-md-2">
            <label class="form-label small text-muted mb-1" for="status">Status</label>
            <select class="form-select" id="status" name="status">
                <option value="active" @(status == "active" ? "selected" : null)>Active</option>
                <option value="inactive" @(status == "inactive" ? "selected" : null)>Inactive</option>
                <option value="all" @(status == "all" ? "selected" : null)>All</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-grid">
            <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Apply</button>
        </div>
    </div>
</form>
