@model BreedViewModel
<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">
        <h1 class="h4 mb-3"><i class="bi bi-diagram-3 text-brand me-2"></i>@ViewBag.Title</h1>
        @using (Html.BeginForm("Save", "Breed", FormMethod.Post, new { @class = "card shadow-sm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.BreedID)
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                <div class="row g-3">
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.BreedCode, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.BreedCode, new { @class = "form-control text-uppercase", maxlength = 20, autofocus = "autofocus" })
                        @Html.ValidationMessageFor(m => m.BreedCode, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-8">
                        @Html.LabelFor(m => m.BreedName, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.BreedName, new { @class = "form-control", maxlength = 100 })
                        @Html.ValidationMessageFor(m => m.BreedName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-12">
                        @Html.LabelFor(m => m.Supplier, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Supplier, new { @class = "form-control", maxlength = 100 })
                    </div>
                    <div class="col-12">
                        @Html.LabelFor(m => m.Description, new { @class = "form-label" })
                        @Html.TextAreaFor(m => m.Description, 3, 0, new { @class = "form-control", maxlength = 250 })
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                        </div>
                    </div>
                </div>
                @Html.Partial("_FormButtons")
            </div>
        }
    </div>
</div>
