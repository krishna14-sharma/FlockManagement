@model MasterListViewModel<Breed>
@{
    ViewBag.Title = "Breeds";
}
@Html.Partial("_ListHeader", new ViewDataDictionary { { "Title", "Breeds" }, { "Icon", "bi-diagram-3" }, { "CanEdit", Model.CanEdit }, { "CreateUrl", Url.Action("Create") }, { "CreateText", "Add Breed" }, { "ExportTarget", "#grid" } })
@Html.Partial("_MasterFilter", new ViewDataDictionary { { "Search", Model.Search }, { "Status", Model.Status } })

<div class="card shadow-sm">
    <div class="table-responsive">
        <table id="grid" class="table table-hover align-middle mb-0 table-stack">
            <thead class="table-light">
                <tr>
                    <th>Code</th>
                    <th>Breed</th>
                    <th>Supplier</th>
                    <th>Description</th>
                    <th>Status</th>
                    @if (Model.CanEdit) { <th class="text-end no-export">Actions</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Result.Items)
                {
                    <tr>
                        <td data-label="Code"><span class="fw-semibold">@b.BreedCode</span></td>
                        <td data-label="Breed">@b.BreedName</td>
                        <td data-label="Supplier">@b.Supplier</td>
                        <td data-label="Description">@b.Description</td>
                        <td data-label="Status">@Html.ActiveBadge(b.IsActive)</td>
                        @if (Model.CanEdit)
                        {
                            <td class="text-end text-nowrap no-export">
                                <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Edit", new { id = b.BreedID })" title="Edit"><i class="bi bi-pencil"></i></a>
                                @Html.Partial("_ToggleActive", new ViewDataDictionary { { "Id", b.BreedID }, { "IsActive", b.IsActive }, { "Controller", "Breed" } })
                            </td>
                        }
                    </tr>
                }
                @if (Model.Result.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No breeds found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
@Html.Pager(Model.Result)
