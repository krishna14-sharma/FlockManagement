@model StandardVsActualViewModel
@{
    ViewBag.Title = "Standard vs Actual";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0"><i class="bi bi-bar-chart-steps text-brand me-2"></i>Standard vs Actual &ndash; all active flocks</h1>
    <button type="button" class="btn btn-outline-secondary btn-sm" data-export-csv="#matrix" data-export-name="Standard vs Actual"><i class="bi bi-filetype-csv me-1"></i>Export CSV</button>
</div>
<form method="get" class="card card-body shadow-sm mb-3 filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-3">
            <label class="form-label small text-muted mb-1">Farm</label>
            @Html.DropDownList("farmId", Model.Picker.Farms, new { @class = "form-select", id = "fFarm", data_cascade_target = "#fHouse", data_cascade_url = Url.Action("Houses", "Lookup"), data_cascade_empty = "All houses", data_cascade_always = "true" })
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small text-muted mb-1">House</label>
            @Html.DropDownList("houseId", Model.Picker.Houses, new { @class = "form-select", id = "fHouse" })
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label small text-muted mb-1">Bird Type</label>
            @Html.DropDownList("birdTypeId", Model.BirdTypes, new { @class = "form-select" })
        </div>
        <div class="col-6 col-md-3 d-grid"><button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Apply</button></div>
    </div>
</form>
<div class="d-flex flex-wrap gap-3 small mb-2">@Html.Raw(string.Join(" ", new[] { "WITHIN", "BELOW", "ABOVE", "CRITICAL", "NODATA" }.Select(c => Html.StatusBadge(c).ToHtmlString())))<span class="text-muted">Values show each flock's latest entered week. Hover a value for its standard.</span></div>
<div class="card shadow-sm">@Html.Partial("_FlockMatrix", Model.Flocks)</div>
