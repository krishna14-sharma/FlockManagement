@model MortalityReasonViewModel
<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">
        <h1 class="h4 mb-3"><i class="bi bi-clipboard-x text-brand me-2"></i>@ViewBag.Title</h1>
        @using (Html.BeginForm("Save", "MortalityReason", FormMethod.Post, new { @class = "card shadow-sm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.MortalityReasonID)
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                <div class="row g-3">
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.ReasonCode, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.ReasonCode, new { @class = "form-control text-uppercase", maxlength = 20, autofocus = "autofocus" })
                        @Html.ValidationMessageFor(m => m.ReasonCode, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-8">
                        @Html.LabelFor(m => m.ReasonName, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.ReasonName, new { @class = "form-control", maxlength = 100 })
                        @Html.ValidationMessageFor(m => m.ReasonName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Category, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Category, new { @class = "form-control", maxlength = 50, list = "cats" })
                        <datalist id="cats">@foreach (var c in Model.Categories) { <option value="@c"></option> }</datalist>
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input", role = "switch" })
                            @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                        </div>
                    </div>
                </div>
                @Html.Partial("_FormButtons")
            </div>
        }
    </div>
</div>
