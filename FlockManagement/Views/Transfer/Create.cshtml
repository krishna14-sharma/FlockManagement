@model TransferCreateViewModel
@{
    ViewBag.Title = "New Transfer";
}
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <h1 class="h4 mb-3"><i class="bi bi-arrow-left-right text-brand me-2"></i>New Transfer</h1>
        @using (Html.BeginForm("Create", "Transfer", FormMethod.Post, new { @class = "card shadow-sm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.FlockID, new { @class = "form-label required" })
                        @Html.DropDownListFor(m => m.FlockID, Model.Flocks, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.FlockID, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(m => m.TransferDate, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.TransferDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.TransferDate, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(m => m.TransferType, new { @class = "form-label required" })
                        <select class="form-select" id="TransferType" name="TransferType">
                            <option value="OUT" @(Model.TransferType == "OUT" ? "selected" : null)>OUT - birds leave this flock</option>
                            <option value="IN" @(Model.TransferType == "IN" ? "selected" : null)>IN - birds join this flock</option>
                            <option value="HOUSE" @(Model.TransferType == "HOUSE" ? "selected" : null)>HOUSE - whole flock moves house</option>
                        </select>
                    </div>
                    <div class="col-md-6 js-house">
                        @Html.LabelFor(m => m.ToHouseID, new { @class = "form-label required" })
                        @Html.DropDownListFor(m => m.ToHouseID, Model.Houses, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.ToHouseID, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6 js-counter">
                        @Html.LabelFor(m => m.CounterFlockID, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.CounterFlockID, Model.Flocks, new { @class = "form-select" })
                        <div class="form-text">Optional. When chosen, the opposite movement is recorded on that flock too.</div>
                    </div>
                    <div class="col-6 col-md-3 js-count">
                        @Html.LabelFor(m => m.FemaleCount, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.FemaleCount, new { @class = "form-control text-end", type = "number", min = 0 })
                        @Html.ValidationMessageFor(m => m.FemaleCount, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-6 col-md-3 js-count">
                        @Html.LabelFor(m => m.MaleCount, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.MaleCount, new { @class = "form-control text-end", type = "number", min = 0 })
                        @Html.ValidationMessageFor(m => m.MaleCount, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-12">
                        @Html.LabelFor(m => m.Reason, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.Reason, new { @class = "form-control", maxlength = 250 })
                        @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger small" })
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Cancel</a>
                    <button type="submit" class="btn btn-primary" data-confirm="Record this transfer? The flock's population will be recalculated."><i class="bi bi-save me-1"></i>Save</button>
                </div>
            </div>
        }
    </div>
</div>
@section scripts {
<script>
    $(function () {
        function sync() {
            var t = $('#TransferType').val();
            $('.js-house').toggle(t === 'HOUSE');
            $('.js-counter, .js-count').toggle(t !== 'HOUSE');
        }
        $('#TransferType').on('change', sync); sync();
    });
</script>
}
