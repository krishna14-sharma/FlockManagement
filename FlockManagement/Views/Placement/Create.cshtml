@model PlacementCreateViewModel
@{
    ViewBag.Title = "Add Placement";
}
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <h1 class="h4 mb-3"><i class="bi bi-box-arrow-in-down text-brand me-2"></i>Add Placement</h1>
        <div class="alert alert-light border small"><i class="bi bi-info-circle text-brand me-1"></i>The flock's first placement sets its placement date and opening birds. Later placements are added to the <strong>Received</strong> birds of the week they fall in, and that week's population is recalculated.</div>
        @using (Html.BeginForm("Create", "Placement", FormMethod.Post, new { @class = "card shadow-sm", novalidate = "novalidate" }))
        {
            @Html.AntiForgeryToken()
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.FlockID, new { @class = "form-label required" })
                        @Html.DropDownListFor(m => m.FlockID, Model.Flocks, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.FlockID, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(m => m.PlacementDate, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.PlacementDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.PlacementDate, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-3">
                        @Html.LabelFor(m => m.HouseID, new { @class = "form-label" })
                        @Html.DropDownListFor(m => m.HouseID, Model.Houses, new { @class = "form-select" })
                    </div>
                    <div class="col-6 col-md-3">
                        @Html.LabelFor(m => m.FemaleCount, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.FemaleCount, new { @class = "form-control text-end", type = "number", min = 0 })
                        @Html.ValidationMessageFor(m => m.FemaleCount, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-6 col-md-3">
                        @Html.LabelFor(m => m.MaleCount, new { @class = "form-label required" })
                        @Html.TextBoxFor(m => m.MaleCount, new { @class = "form-control text-end", type = "number", min = 0 })
                        @Html.ValidationMessageFor(m => m.MaleCount, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-6 col-md-3">
                        @Html.LabelFor(m => m.ChickAvgWeight, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ChickAvgWeight, new { @class = "form-control text-end", type = "number", step = "0.1", min = 0 })
                        @Html.ValidationMessageFor(m => m.ChickAvgWeight, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-6 col-md-3">
                        @Html.LabelFor(m => m.Source, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Source, new { @class = "form-control", maxlength = 100, placeholder = "Hatchery" })
                    </div>
                    <div class="col-12">
                        @Html.LabelFor(m => m.Remarks, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control", maxlength = 250 })
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a class="btn btn-outline-secondary" href="@Url.Action("Index", new { flockId = Model.FlockID == 0 ? (int?)null : Model.FlockID })">Cancel</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save</button>
                </div>
            </div>
        }
    </div>
</div>
